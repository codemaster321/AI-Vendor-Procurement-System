# Backend Environment Variables

# Server
PORT=5000

# Frontend URL allowed by CORS (production: your deployed frontend URL)
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rfp_manager
# For local MongoDB: mongodb://localhost:27017/rfp_manager

# Optional: public DNS for mongodb+srv lookups, if your router's DNS fails
# with "querySrv ENOTFOUND". Not needed on most hosts.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT secret (REQUIRED - use a long random string)
JWT_SECRET=your_jwt_secret_key_here

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Email (Gmail app password) - used for sending RFPs and reading vendor replies
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_specific_password

# Optional IMAP overrides (defaults: imap.gmail.com:993)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
