# Backend Environment Variables

# Server
PORT=5000

# SECURITY: Frontend URL for CORS (production should be your actual frontend URL)
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rfp_manager
# For local MongoDB: mongodb://localhost:27017/rfp_manager

# SECURITY: JWT Secret (REQUIRED - use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Email Configuration (SMTP - for sending)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_specific_password

# Email Configuration (IMAP - for receiving)
IMAP_USER=your.email@gmail.com
IMAP_PASSWORD=your_app_specific_password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true

# Optional: Logging
NODE_ENV=development
LOG_LEVEL=info
